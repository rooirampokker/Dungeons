{
  "name": "dungeons",
  "version": "2.0.0",
  "private": true,
  "description": "A browser-based random dungeon generator and explorer",
  "type": "module",
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "test": "node --test \"test/**/*.test.js\"",
    "tiles:gormenghast": "node scripts/tilesets/gormenghast/build.js",
    "tiles:starbase": "node scripts/tilesets/starbase/build.js",
    "tiles:fairywood": "node scripts/tilesets/fairywood/build.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rooirampokker/Dungeons.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rooirampokker/Dungeons/issues"
  },
  "homepage": "https://github.com/rooirampokker/Dungeons#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jquery": "^3.7.1"
  },
  "devDependencies": {
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  }
}
